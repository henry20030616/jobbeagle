# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google Analytics 4 (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Agent 代跑 CLI / Management API（一次性從 https://supabase.com/dashboard/account/tokens 產生）
SUPABASE_ACCESS_TOKEN=

# PayPal (https://developer.paypal.com/dashboard/)
# Use live credentials for production. One-time products need no plan ID.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=live
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_STANDARD_SUB=
PAYPAL_PLAN_ADVANCED_SUB=

# Optional: Upstash Redis rate limiting (preferred in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# If unset, APIs fall back to in-memory rate limits (never fail-open)

# Feature flags
# Shorts / employer video surface — default frozen. Set true to re-enable.
# NEXT_PUBLIC_SHORTS_ENABLED=true

# Optional: Cron secret for /api/cron/purge-reports (also signs extension handoff sid tokens)
CRON_SECRET=

# Optional: dedicated secret for extension POST /api/extension-capture (falls back to CRON_SECRET)
EXTENSION_HANDOFF_SECRET=
