# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google Analytics 4 (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Agent 代跑 CLI / Management API（一次性從 https://supabase.com/dashboard/account/tokens 產生）
SUPABASE_ACCESS_TOKEN=

# Lemon Squeezy (payment provider — https://lemonsqueezy.com)
# Dashboard → Settings → API → Create API key
# Store ID: Settings → Stores
# Webhook: https://你的網域/api/payment/webhook
#   Events: order_created, subscription_created, subscription_payment_success
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=424272
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=true

# Variant IDs — create products in Lemon Squeezy, then paste Variant ID here
# Single Lite ($3): can reuse existing basic overage variant
LEMONSQUEEZY_VARIANT_SINGLE_LITE=1869600
LEMONSQUEEZY_VARIANT_BASIC_OVERAGE=1869600

# Single Full ($9.99) — create new product in LS dashboard
LEMONSQUEEZY_VARIANT_SINGLE_FULL=

# Standard subscription ($19.99/mo, 100 Snapshot + 5 Guide)
LEMONSQUEEZY_VARIANT_STANDARD_SUB=

# Advanced subscription ($39.99/mo, 300 Snapshot + 15 Guide)
LEMONSQUEEZY_VARIANT_ADVANCED_SUB=

# Legacy (optional backward compat)
LEMONSQUEEZY_VARIANT_PREMIUM_REPORT=1869607
LEMONSQUEEZY_VARIANT_MONTHLY=1869610

# Optional: Upstash Redis rate limiting (preferred in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# If unset, APIs fall back to in-memory rate limits (never fail-open)

# Feature flags
# Shorts / employer video surface — default frozen. Set true to re-enable.
# NEXT_PUBLIC_SHORTS_ENABLED=true

# Optional: Cron secret for /api/cron/purge-reports (also signs extension handoff sid tokens)
CRON_SECRET=

# Optional: dedicated secret for extension POST /api/extension-capture (falls back to CRON_SECRET)
EXTENSION_HANDOFF_SECRET=
