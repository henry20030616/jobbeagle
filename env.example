# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google Analytics 4 (選填，未設定則不載入追蹤)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Required for quota enforcement, checkout webhooks, and order fulfillment
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Lemon Squeezy (https://lemonsqueezy.com)
# 1. Dashboard → Settings → API → Create API key
# 2. Store ID：Settings → Stores → 網址或 API
# 3. 建立三個產品變體後，把 Variant ID 貼到下方
# 4. Settings → Webhooks → URL: https://你的網域/api/payment/webhook
#    Events: order_created, subscription_created, subscription_payment_success
#    Signing secret → LEMONSQUEEZY_WEBHOOK_SECRET
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_BASIC_OVERAGE=
LEMONSQUEEZY_VARIANT_PREMIUM_REPORT=
LEMONSQUEEZY_VARIANT_MONTHLY=
# 本機測試設為 true（Lemon Squeezy Test mode）
LEMONSQUEEZY_TEST_MODE=true
