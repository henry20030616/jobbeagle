{
  "manifest_version": 3,
  "name": "JobBeagle - Headhunter-Level Job Triage",
  "version": "1.0.0",
  "description": "Instant semantic fit scoring and live interview intel extraction.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Analyze with JobBeagle",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.linkedin.com/jobs/*",
    "https://www.jobbeagle.com/*",
    "http://localhost:3000/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
